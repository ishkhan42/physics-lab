# Copy to a private location outside the public-facing project tree.
# Link that file as the ignored project .env, or supply an authorized environment.
# OpenRouter is the default Pi lab provider when its key is configured.
# Keys stay in the server broker; no credentials enter the no-network sandbox.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional, explicit operator authorization to use Connected GPT (GPT-6 Luna, High).
# Local mode requires OMP installed/signed in; only the broker resolves tokens.
# Hosted mode additionally requires the bounded demo settings below.
PHYSICS_LAB_CONNECTED_GPT=0

# Optional private SQLite file path; otherwise the OS application-data directory is used.
SCENE_DB_PATH=

# Optional hosted API mode. Leave unset for the local SQLite/Docker lab.
# Comma-separated HTTPS origins; hosted OpenRouter routes remain free-only.
PUBLIC_ORIGINS=
FIRESTORE_PROJECT_ID=
# Authenticated private gateway, for example ws://worker.example:8081/run.
LAB_WORKER_URL=
# Private IAM-protected renderer origin; the API identity needs invocation permission.
LAB_RENDERER_URL=
# API/gateway transport credential, never forwarded into the agent container.
# In cloud deployments load this and OPENROUTER_API_KEY through Secret Manager.
WORKER_AUTH_TOKEN=

# Optional explicitly authorized subscription demo; public access consumes owner quota.
# Absolute UTC ISO expiry, independent of saved-scene retention.
LAB_DEMO_EXPIRES_AT=
# Secret Manager resource: projects/PROJECT_ID/secrets/SECRET_ID.
# Use a separate hosted OAuth session, never copy the local OMP login store.
# The API needs expiring access and version-add permissions for credential rotation.
CONNECTED_GPT_SECRET=
