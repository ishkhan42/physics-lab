{
  "name": "physics-lab",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "sandbox:build": "vite build --config vite.inspection.config.ts && docker build -f sandbox/Dockerfile -t physics-lab-harness:local .",
    "preapi": "npm run sandbox:build",
    "prestart": "npm run sandbox:build",
    "api": "node --env-file-if-exists=.env --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "start": "node --env-file-if-exists=.env server/index.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@mujoco/mujoco": "3.16.0",
    "@phosphor-icons/react": "2.1.10",
    "puppeteer-core": "25.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "typebox": "1.3.27",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
